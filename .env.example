# handoff-mcp configuration
# Copy this file to .env and adjust the paths for your machine.

# Path to Cowork's output folder. The Cowork watcher monitors this directory
# for new/modified files and indexes them into the cowork_sessions collection.
# Windows example shown; on macOS/Linux use a POSIX path.
COWORK_OUTPUT_FOLDER=C:\Users\you\Documents\Cowork

# Root of the Claude Code project to monitor. The Code watcher (watchers/code.py)
# indexes its curated context (CLAUDE.md/CLAUDE.local.md, transcripts/ & .claude/
# dirs, *.jsonl) into the code_sessions collection.
CODE_PROJECT_PATH=C:\Users\you\projects\my-project

# Where the local ChromaDB store lives. Optional.
# Defaults to ~/.handoff/db (expands to your home directory) if unset.
HANDOFF_STORE_PATH=C:\Users\you\.handoff\db

# --- Optional Chroma server overrides ---
# The MCP server talks to a local Chroma server over HTTP. If one is already
# running you can point at it; otherwise the server is started automatically.
# CHROMA_HOST=localhost
# CHROMA_PORT=8000
