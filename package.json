{
  "name": "handoff-mcp",
  "version": "0.4.0",
  "description": "MCP server providing cross-product handoff context for strategist and code workflows.",
  "type": "module",
  "bin": {
    "handoff-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test:store": "node scripts/test-store.mjs",
    "test:restart": "node scripts/test-restart.mjs",
    "test:cwd": "node scripts/test-cwd.mjs",
    "test:owner-exit": "node scripts/test-owner-exit.mjs",
    "test:env-empty": "node scripts/test-env-empty.mjs",
    "test:recency": "node scripts/test-recency.mjs",
    "test:hybrid": "node scripts/test-hybrid.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test:integration": "node scripts/integration.mjs",
    "test": "node scripts/test-store.mjs && node scripts/test-restart.mjs && node scripts/test-cwd.mjs && node scripts/test-owner-exit.mjs && node scripts/test-env-empty.mjs && node scripts/test-recency.mjs && node scripts/test-hybrid.mjs && node scripts/smoke.mjs && node scripts/integration.mjs",
    "demo": "node demo/seed.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@chroma-core/default-embed": "^0.1.9",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "chromadb": "^3.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
